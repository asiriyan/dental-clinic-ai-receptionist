# DENTTORA DENTAL CLINIC - UNIFIED ENVIRONMENT CONFIGURATION
# This single .env file is used by BOTH the React/Node Express server and the Python scripts.

# N8N WEBHOOK CONFIGURATION
# Set your n8n Dental Clinic AI Chatbot Webhook URL here
# Example: https://your-n8n-instance.app/webhook/dental-chat
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/dental-chat
# LIVEKIT REAL-TIME VOICE ROOM CONFIGURATION
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
#curl -X POST "https://api.deepgram.com/v1/speak?model=aura-2-thalia-en" -H "Authorization: Token 37162f42176fb3ccb5d720276e30c2b6ea4bd86c" -H "Content-Type: application/json" -d "{\"text\": \"Hello from Deepgram\"}" --output test.mp3
# DEEPGRAM SPEECH-TO-TEXT API KEY
DEEPGRAM_API_KEY=
FORM_REGEX_FALLBACK=false
# GEMINI API KEY (Optional: Only if running the standalone Python Amharic test scripts)
GEMINI_API_KEY=
N8N_TIMEOUT="90"

# 2. Simulator Switch (MUST be false to reach n8n)
ENABLE_SIMULATOR="false"
