# ==============================================================================
# DENTTORA DENTAL CLINIC - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. n8n Webhook Configuration
# IMPORTANT: Use 127.0.0.1 instead of localhost to prevent IPv6 [::1] connection issues.
# Use the Production URL (/webhook/dental-chat) and toggle the workflow switch to ACTIVE in n8n.
N8N_WEBHOOK_URL="http://127.0.0.1:5678/webhook/dental-chat"
N8N_TIMEOUT="90"

# 2. Simulator Mode (CRITICAL)
# Set to 'false' so FastAPI forwards live messages to n8n instead of returning fake local replies.
ENABLE_SIMULATOR="false"

# 3. Optional Voice & Integrations
DEEPGRAM_API_KEY=""
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# 4. CORS Allowed Origins
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
